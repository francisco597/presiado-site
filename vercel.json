{
  "ignoreCommand": "python3 .github/compliance/check_compliance.py .; if [ $? -eq 1 ]; then echo 'Deploy BLOQUEADO por cumplimiento'; exit 0; fi; exit 1",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/drywall-contractor-sarasota",
      "destination": "/drywall-finishing-sarasota",
      "permanent": true
    },
    {
      "source": "/water-damage-ceiling-repair-sarasota",
      "destination": "/ceiling-repair-sarasota",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}
